{"question_id": "NHQ-CCNA-1C2F9E24-0A1B-43E8-984D-92D19AAAA771", "chapter_id": "CCNA-D1", "topic_id": "CCNA-D1-T05", "concept_tag": "core", "difficulty": "medium", "format": "mcq", "competency": "application", "stem": "Which subnet mask provides exactly 14 usable hosts?", "options": ["255.255.255.224", "255.255.255.240", "255.255.255.248", "255.255.255.252"], "correct": ["B"], "explanation": "/28 (255.255.255.240) has 4 host bits: 2^4 = 16 - 2 = 14 usable hosts.", "marks": 1, "source": {"kind": "nhprep_quiz", "ref": "nhprep:quiz/ccna/1c2f9e24-0a1b-43e8-984d-92d19aaaa771"}, "lesson_ref": null, "key_origin": "nhprep"}
{"question_id": "NHQ-CCNA-34C096B5-8913-412F-BEFF-B6EBD1E18EAF", "chapter_id": "CCNA-D1", "topic_id": "CCNA-D1-T11", "concept_tag": "core", "difficulty": "medium", "format": "mcq", "competency": "application", "stem": "What happens when a switch receives a frame with an unknown destination MAC on VLAN 10?", "options": ["Drops the frame", "Floods the frame to all ports in VLAN 10", "Forwards it to the default gateway", "Sends it to all VLANs"], "correct": ["B"], "explanation": "When the destination MAC is not in the MAC address table, the switch floods to all ports in the same VLAN except the ingress port.", "marks": 1, "source": {"kind": "nhprep_quiz", "ref": "nhprep:quiz/ccna/34c096b5-8913-412f-beff-b6ebd1e18eaf"}, "lesson_ref": null, "key_origin": "nhprep"}
{"question_id": "NHQ-CCNA-4385682D-FFB8-4AD0-9135-A965822379E7", "chapter_id": "CCNA-D1", "topic_id": "CCNA-D1-T05", "concept_tag": "core", "difficulty": "easy", "format": "mcq", "competency": "knowledge_understanding", "stem": "What is the default subnet mask for a Class B IP address?", "options": ["255.0.0.0", "255.255.0.0", "255.255.255.0", "255.255.255.128"], "correct": ["B"], "explanation": "Class B addresses (128.0.0.0 to 191.255.255.255) use a default mask of 255.255.0.0 (/16).", "marks": 1, "source": {"kind": "nhprep_quiz", "ref": "nhprep:quiz/ccna/4385682d-ffb8-4ad0-9135-a965822379e7"}, "lesson_ref": null, "key_origin": "nhprep"}
{"question_id": "NHQ-CCNA-5198C1A8-B4F3-4DF3-970C-522A4B4ADBA9", "chapter_id": "CCNA-D1", "topic_id": "CCNA-D1-T11", "concept_tag": "core", "difficulty": "easy", "format": "mcq", "competency": "knowledge_understanding", "stem": "What is the primary function of ARP?", "options": ["Resolve IP addresses to MAC addresses", "Resolve domain names to IP addresses", "Route packets between networks", "Encrypt data in transit"], "correct": ["A"], "explanation": "ARP (Address Resolution Protocol) maps IP addresses to MAC addresses so frames can be delivered on the local segment.", "marks": 1, "source": {"kind": "nhprep_quiz", "ref": "nhprep:quiz/ccna/5198c1a8-b4f3-4df3-970c-522a4b4adba9"}, "lesson_ref": null, "key_origin": "nhprep"}
