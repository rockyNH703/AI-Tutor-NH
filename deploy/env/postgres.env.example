# /etc/aichat/postgres.env   -- chmod 600, root:root, NEVER in git
# Read by deploy/compose/docker-compose.yml, deploy/install.sh and deploy/backup.sh.
# This account owns the PadhAI database and runs migrations; the API must use the separate
# runtime account named by POSTGRES_RUNTIME_USER (see docs/deployment.md).
POSTGRES_USER=padhai_migrator
# Generate: openssl rand -base64 36
POSTGRES_PASSWORD=
POSTGRES_DB=padhai
# Configurable loopback host port. 55432 is the approved default; inventory the host before use.
POSTGRES_HOST_PORT=55432
POSTGRES_RUNTIME_USER=padhai_runtime
POSTGRES_AUTH_USER=aichat_auth
# Backups (deploy/backup.sh). This directory is dedicated to PadhAI dumps.
BACKUP_DIR=/var/backups/padhai
KEEP_DAYS=7
