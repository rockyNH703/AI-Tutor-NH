# /etc/netsecai/postgres.env   -- chmod 600, root:root, NEVER in git
# Read by deploy-netsec/compose/docker-compose.yml, deploy-netsec/install.sh and deploy-netsec/backup.sh.
# This account owns the NetSec AI database and runs migrations; the API must use the separate
# runtime account named by POSTGRES_RUNTIME_USER (see docs/deployment.md).
POSTGRES_USER=netsecai_migrator
# Generate: openssl rand -base64 36
POSTGRES_PASSWORD=
POSTGRES_DB=netsecai
# Fixed isolated loopback host port. Do not change or reuse a protected production port.
POSTGRES_HOST_PORT=55432
POSTGRES_RUNTIME_USER=netsecai_runtime
# Generate separately: openssl rand -base64 36
POSTGRES_RUNTIME_PASSWORD=
POSTGRES_AUTH_USER=netsecai_auth
# Generate separately: openssl rand -base64 36
POSTGRES_AUTH_PASSWORD=
# Generate once: openssl rand -hex 32. Immutable identity for this isolated database.
# Every database migration, grant, backup, status and infrastructure operation verifies it.
NETSECAI_DB_IDENTITY=
# Backups (deploy-netsec/backup.sh). This directory is dedicated to NetSec AI dumps.
BACKUP_DIR=/var/backups/netsecai
KEEP_DAYS=7
