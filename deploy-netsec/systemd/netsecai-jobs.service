[Unit]
# One run of the jobs worker (backend/app/jobs) from the production checkout /opt/netsecai/app:
# email outbox, reminders, retention. Started every minute by netsecai-jobs.timer; runs once, exits.
# - Installed but NOT enabled: enabling the timer is a deliberate step (docs/deployment.md,
#   "Jobs worker"). JOBS_ENABLED=false in api.env also makes a run a no-op.
# - A commit without the worker (a rollback to an older one) skips the run: see the Condition.
# - One run at a time: systemd never starts a oneshot unit that is still running, and the
#   worker holds a database lock.
Description=netsecai jobs worker (one run)
Requires=netsecai-postgres.service
After=netsecai-postgres.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/netsecai/app/backend/app/jobs/__main__.py
# Not while a deploy changes the checkout and the schema (deploy-netsec/server/update.sh writes the
# marker for its whole run): the next timer tick runs the new release against the migrated schema.
ConditionPathExists=!/run/netsecai-deploying

[Service]
Type=oneshot
WorkingDirectory=/opt/netsecai/app/backend
EnvironmentFile=/etc/netsecai/api.env
ExecStart=/opt/netsecai/app/backend/.venv/bin/python -m app.jobs
TimeoutStartSec=300
MemoryMax=400M
NoNewPrivileges=yes
PrivateTmp=yes
