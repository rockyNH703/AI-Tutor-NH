[Unit]
Description=netsecai knowledge worker (one bounded revision)
Requires=netsecai-postgres.service
After=netsecai-postgres.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/netsecai/app/backend/app/knowledge/__main__.py
# Not while a deploy changes the checkout and the schema (deploy-netsec/server/update.sh writes the
# marker for its whole run): the next timer tick runs the new release against the migrated schema.
ConditionPathExists=!/run/netsecai-deploying

[Service]
Type=oneshot
WorkingDirectory=/opt/netsecai/app/backend
EnvironmentFile=/etc/netsecai/api.env
ExecStart=/opt/netsecai/app/backend/.venv/bin/python -m app.knowledge
# Above the extractor's hour (processing.EXTRACT_TIMEOUT_S) plus embedding: a long scanned book must finish, not
# restart every tick. The heartbeat keeps its lease fresh meanwhile.
TimeoutStartSec=7200
# The worker and its extractors (systemd-run --slice) share this slice's low weights and memory ceiling.
Slice=netsecai-knowledge.slice
MemoryMax=600M
MemorySwapMax=0
CPUQuota=100%
TasksMax=64
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
