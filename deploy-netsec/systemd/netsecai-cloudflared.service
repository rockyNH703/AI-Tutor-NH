[Unit]
Description=NetSec AI Cloudflare Quick Tunnel
After=network-online.target netsecai-web.service
Wants=network-online.target
Requires=netsecai-web.service

[Service]
Type=simple
# Manager-approved Cloudflare default hostname. Cloudflare prints the generated
# https://*.trycloudflare.com URL to this unit's journal at every start.
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --config /dev/null --url http://127.0.0.1:4300
Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
